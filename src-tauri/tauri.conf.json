{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "页间",
  "version": "0.1.0",
  "identifier": "cn.patchouli.books",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && tauri icon src-tauri/app-icon.svg",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "页间 · 图书检索",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Patchouli, the Unmoving Great Library"
  }
}
